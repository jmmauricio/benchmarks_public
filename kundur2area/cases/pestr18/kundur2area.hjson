{
// Kundur Two-Area, 4-Generator benchmark — PESTR18 variant (VERBATIM).
// Source: IEEE PES Task Force on Benchmark Systems for Stability Controls,
// "Benchmark Systems for Small-Signal Stability Analysis and Control",
// PES-TR18 (August 2015) §5.3 + Appendix C (Lima & Silva).
//
// Differences from Kundur's textbook (Example 12.6 — see ../base/):
//   • MBASE = 666.7 MVA per machine (Kundur: 900 MVA).
//   • 14 parallel circuits (Kundur: 8) — extra circuits added at 5-6, 6-7,
//     9-10, 10-11 to allow weaker-system studies.
//   • IEEE ST1A excitation system w/ TGR + V_R limiter (Kundur: simple
//     proportional + transducer only).
//   • IEEE PSS1A stabiliser available (Kundur: PSS optional, off here).
//
// PESTR18 defines three configurations for this system:
//   Case 4: ESST1A WITH TGR (T_C=1, T_B=10), no PSS
//   Case 5: ESST1A WITHOUT TGR (T_C=T_B=0), no PSS   ← Table 5.30 eigenvalues
//   Case 6: ESST1A WITHOUT TGR + PSS                  ← stabilised system
// This file defaults to Case 6 with PESTR18-exact gains:
//   • T_C = T_B = 0.001 (TGR effectively unity — pydae's st1.py needs T_B > 0
//     to avoid division by zero in the lead-lag state equation, so we use a
//     small regulariser instead of exact 0).
//   • K_stab = 20 on every PSS.
// To recover Case 5 (matches Table 5.30 verbatim), set K_stab = 0 on every
// gen.  To get Case 4, set K_stab = 0 and T_C = 1.0, T_B = 10.0.
// System base: S_base = 100 MVA, 60 Hz. Transmission 230 kV, generators 20 kV.

system: {name: "kundur2area", S_base: 100e6},
agc: {K_p_agc: 0.0, K_i_agc: 0.01, gen: "G03"}

// PESTR18 Table 5.20 — Bus Data and Power Flow Solution (verbatim).
buses: [
  {name: "01", P_W: 0, Q_var: 0, U_kV:  20.0},   // GEN G1 (Area 1, PV)
  {name: "02", P_W: 0, Q_var: 0, U_kV:  20.0},   // GEN G2 (Area 1, PV)
  {name: "03", P_W: 0, Q_var: 0, U_kV:  20.0},   // GEN G3 (Area 2, swing)
  {name: "04", P_W: 0, Q_var: 0, U_kV:  20.0},   // GEN G4 (Area 2, PV)
  {name: "05", P_W: 0, Q_var: 0, U_kV: 230.0},   // G1 HV
  {name: "06", P_W: 0, Q_var: 0, U_kV: 230.0},   // G2 HV
  {name: "07", P_W: 0, Q_var: 0, U_kV: 230.0},   // LOAD A
  {name: "08", P_W: 0, Q_var: 0, U_kV: 230.0},   // MID POINT (tie)
  {name: "09", P_W: 0, Q_var: 0, U_kV: 230.0},   // LOAD B
  {name: "10", P_W: 0, Q_var: 0, U_kV: 230.0},   // G4 HV
  {name: "11", P_W: 0, Q_var: 0, U_kV: 230.0}    // G3 HV
],

// PESTR18 Tables 5.23 + 5.24 — loads merged with capacitor banks.
//   Bus 7:  967 MW, 100 Mvar load + 200 Mvar cap → net 967 MW, -100 Mvar
//   Bus 9: 1767 MW, 100 Mvar load + 350 Mvar cap → net 1767 MW, -250 Mvar
// PESTR18 §5.3.1: "100% I for P, 100% Z for Q".  Capacitor banks stay on the
// Z branch (negative q_mvar).
loads: [
  {bus: "07", type: "zip", p_mw:  967, q_mvar: -100, K_ip: 1.0, K_zq: 1.0},
  {bus: "09", type: "zip", p_mw: 1767, q_mvar: -250, K_ip: 1.0, K_zq: 1.0}
],

// PESTR18 Table 5.21 — Transmission Line Data (14 parallel circuits, on
// 100 MVA / 230 kV base; R, X, charging in percent).
lines: [
  {bus_j: "05", bus_k: "06", R_pu: 0.005, X_pu: 0.050, B_pu: 0.021875, S_mva: 100.0},  //  25 km ckt 1
  {bus_j: "05", bus_k: "06", R_pu: 0.005, X_pu: 0.050, B_pu: 0.021875, S_mva: 100.0},  //  25 km ckt 2
  {bus_j: "06", bus_k: "07", R_pu: 0.003, X_pu: 0.030, B_pu: 0.005833, S_mva: 100.0},  //  10 km ckt 1
  {bus_j: "06", bus_k: "07", R_pu: 0.003, X_pu: 0.030, B_pu: 0.005833, S_mva: 100.0},  //  10 km ckt 2
  {bus_j: "06", bus_k: "07", R_pu: 0.003, X_pu: 0.030, B_pu: 0.005833, S_mva: 100.0},  //  10 km ckt 3
  {bus_j: "07", bus_k: "08", R_pu: 0.011, X_pu: 0.110, B_pu: 0.192500, S_mva: 100.0},  // 110 km ckt 1
  {bus_j: "07", bus_k: "08", R_pu: 0.011, X_pu: 0.110, B_pu: 0.192500, S_mva: 100.0},  // 110 km ckt 2
  {bus_j: "08", bus_k: "09", R_pu: 0.011, X_pu: 0.110, B_pu: 0.192500, S_mva: 100.0},  // 110 km ckt 1
  {bus_j: "08", bus_k: "09", R_pu: 0.011, X_pu: 0.110, B_pu: 0.192500, S_mva: 100.0},  // 110 km ckt 2
  {bus_j: "09", bus_k: "10", R_pu: 0.003, X_pu: 0.030, B_pu: 0.005833, S_mva: 100.0},  //  10 km ckt 1
  {bus_j: "09", bus_k: "10", R_pu: 0.003, X_pu: 0.030, B_pu: 0.005833, S_mva: 100.0},  //  10 km ckt 2
  {bus_j: "09", bus_k: "10", R_pu: 0.003, X_pu: 0.030, B_pu: 0.005833, S_mva: 100.0},  //  10 km ckt 3
  {bus_j: "10", bus_k: "11", R_pu: 0.005, X_pu: 0.050, B_pu: 0.021875, S_mva: 100.0},  //  25 km ckt 1
  {bus_j: "10", bus_k: "11", R_pu: 0.005, X_pu: 0.050, B_pu: 0.021875, S_mva: 100.0}   //  25 km ckt 2
],

// PESTR18 Table 5.22 — Generator Step-Up Transformers (4×900 MVA, X=15% on
// transformer MVA base, tap=1.0, no winding resistance).
transformers: [
  {bus_j: "05", bus_k: "01", R_pu: 0.0, X_pu: 0.15, S_mva: 900.0, tap_m: 1.0},
  {bus_j: "06", bus_k: "02", R_pu: 0.0, X_pu: 0.15, S_mva: 900.0, tap_m: 1.0},
  {bus_j: "11", bus_k: "03", R_pu: 0.0, X_pu: 0.15, S_mva: 900.0, tap_m: 1.0},
  {bus_j: "10", bus_k: "04", R_pu: 0.0, X_pu: 0.15, S_mva: 900.0, tap_m: 1.0}
],

// Placeholder shunt at the tie midpoint for fault injection during run().
shunts: [{bus:"08", X_pu:1e6, R_pu:0.0, S_mva:100}],

// PESTR18 Table 5.26 — synchronous machine data (MBASE=666.7 MVA, PSS/E GENROE
// = pydae genroe, 6th-order Anderson-Fouad, terminal-referred subtransient).
//   T'_d0=8.0s, T''_d0=0.03s, T'_q0=0.4s, T''_q0=0.05s; D=0;
//   X_d=1.8, X_q=1.7, X'_d=0.3, X'_q=0.55, X''_d=X''_q=0.25.
//   X_l=0.20 (per PESTR18) NOT passed — IEEE 1110 / PSS/E convention treats
//   X''_d, X''_q as terminal-referred (X_l already folded in).
//   Saturation (geometric, GENROE): S(1.0)=0.0392, S(1.2)=0.2672.
//   Inertias: H=6.50 (G1,G2) / 6.175 (G3,G4).
//
// PESTR18 Table 5.28 — IEEE ST1A static excitation system (pydae avrs/st1):
//   T_R=0.01, K_A=200, V_I±99 (inactive), V_R±4.  TGR set to T_C=T_B=0.001
//   (effective unity) per Case 5/6 definition — see header comment.
//
// PESTR18 Table 5.29 — IEEE PSS1A stabiliser (pydae psss/pss_kundur_2):
//   K_S=20, T_w=10, T_1=0.05, T_2=0.02, T_3=3.0, T_4=5.4, L_S±0.05.
//   Enabled by default (Case 6).  Set K_stab=0 on every gen to reproduce
//   Case 5 (the unstable configuration whose eigenvalues are in Table 5.30).
syns: [
  // G1 — Area 1 (PV bus, V=1.030 ∠ 20.07°, P=700 MW, Q=185 Mvar)
  {bus: "01", name: "G01", type: "genroe",
    S_n: 666.7e6, F_n: 60, H: 6.50, D: 0, R_a: 0.0,
    X_d: 1.8, X_q: 1.7, X1d: 0.3, X1q: 0.55, T1d0: 8.0, T1q0: 0.4,
    X2d: 0.25, X2q: 0.25, T2d0: 0.03, T2q0: 0.05,
    S_10: 0.0392, S_12: 0.2672,
    K_sec: 0, K_delta: 0,
    avr: {type: "st1", K_A: 200.0, T_R: 0.01, T_C: 0.001, T_B: 0.001, V_Imax: 99.0, V_Imin: -99.0, V_Rmax: 4.0, V_Rmin: -4.0, v_ref: 1.030},
    gov: {type: "tgov1", R: 0.05, T_1: 0.5, V_max: 100.0, V_min: -100.0, T_2: 2.1, T_3: 7.0, D_t: 0.0},
    pss: {type: "pss_kundur_2", K_stab: 20.0, T_w: 10.0, T_1: 0.05, T_2: 0.02, T_3: 3.0, T_4: 5.4, V_Smax: 0.05, V_Smin: -0.05},
    lc:  {K_i: 0.01, p_c_lc: 1.0500}
  },
  // G2 — Area 1 (PV bus, V=1.010 ∠ 10.31°, P=700 MW, Q=234.6 Mvar)
  {bus: "02", name: "G02", type: "genroe",
    S_n: 666.7e6, F_n: 60, H: 6.50, D: 0, R_a: 0.0,
    X_d: 1.8, X_q: 1.7, X1d: 0.3, X1q: 0.55, T1d0: 8.0, T1q0: 0.4,
    X2d: 0.25, X2q: 0.25, T2d0: 0.03, T2q0: 0.05,
    S_10: 0.0392, S_12: 0.2672,
    K_sec: 0, K_delta: 0,
    avr: {type: "st1", K_A: 200.0, T_R: 0.01, T_C: 0.001, T_B: 0.001, V_Imax: 99.0, V_Imin: -99.0, V_Rmax: 4.0, V_Rmin: -4.0, v_ref: 1.010},
    gov: {type: "tgov1", R: 0.05, T_1: 0.5, V_max: 100.0, V_min: -100.0, T_2: 2.1, T_3: 7.0, D_t: 0.0},
    pss: {type: "pss_kundur_2", K_stab: 20.0, T_w: 10.0, T_1: 0.05, T_2: 0.02, T_3: 3.0, T_4: 5.4, V_Smax: 0.05, V_Smin: -0.05},
    lc:  {K_i: 0.01, p_c_lc: 1.0500}
  },
  // G4 — Area 2 (PV bus, V=1.010 ∠ -17.19°, P=700 MW, Q=202 Mvar)
  {bus: "04", name: "G04", type: "genroe",
    S_n: 666.7e6, F_n: 60, H: 6.175, D: 0, R_a: 0.0,
    X_d: 1.8, X_q: 1.7, X1d: 0.3, X1q: 0.55, T1d0: 8.0, T1q0: 0.4,
    X2d: 0.25, X2q: 0.25, T2d0: 0.03, T2q0: 0.05,
    S_10: 0.0392, S_12: 0.2672,
    K_sec: 0, K_delta: 0,
    avr: {type: "st1", K_A: 200.0, T_R: 0.01, T_C: 0.001, T_B: 0.001, V_Imax: 99.0, V_Imin: -99.0, V_Rmax: 4.0, V_Rmin: -4.0, v_ref: 1.010},
    gov: {type: "tgov1", R: 0.05, T_1: 0.5, V_max: 100.0, V_min: -100.0, T_2: 2.1, T_3: 7.0, D_t: 0.0},
    pss: {type: "pss_kundur_2", K_stab: 20.0, T_w: 10.0, T_1: 0.05, T_2: 0.02, T_3: 3.0, T_4: 5.4, V_Smax: 0.05, V_Smin: -0.05},
    lc:  {K_i: 0.01, p_c_lc: 1.0500}
  },
  // G3 — Area 2 swing bus (V=1.030 ∠ -7.00°, P=719.1 MW, Q=176 Mvar).
  // Reference machine: K_delta>0, Delta_ref=0 to anchor the absolute angle.
  // AGC drives p_c_G03 (PI on rotor speed, see top-level agc:).
  {bus: "03", name: "G03", type: "genroe",
    S_n: 666.7e6, F_n: 60, H: 6.175, D: 0, R_a: 0.0,
    X_d: 1.8, X_q: 1.7, X1d: 0.3, X1q: 0.55, T1d0: 8.0, T1q0: 0.4,
    X2d: 0.25, X2q: 0.25, T2d0: 0.03, T2q0: 0.05,
    S_10: 0.0392, S_12: 0.2672,
    K_sec: 0, K_delta: 0.001, Delta_ref: 0,
    avr: {type: "st1", K_A: 200.0, T_R: 0.01, T_C: 0.001, T_B: 0.001, V_Imax: 99.0, V_Imin: -99.0, V_Rmax: 4.0, V_Rmin: -4.0, v_ref: 1.030},
    gov: {type: "tgov1", R: 0.05, T_1: 0.5, V_max: 100.0, V_min: -100.0, T_2: 2.1, T_3: 7.0, D_t: 0.0, p_c: 1.0786},
    pss: {type: "pss_kundur_2", K_stab: 20.0, T_w: 10.0, T_1: 0.05, T_2: 0.02, T_3: 3.0, T_4: 5.4, V_Smax: 0.05, V_Smin: -0.05}
  }
]

// ── VALIDATION RESULTS (PESTR18 §5.3 / Appendix C, verbatim) ──────────────
results: {

  // PESTR18 Table 5.20 / App. C Table 1 — Bus voltages and angles.
  buses: [
    {name: "01", V_pu: 1.0300, theta_deg:  20.07},
    {name: "02", V_pu: 1.0100, theta_deg:  10.31},
    {name: "03", V_pu: 1.0300, theta_deg:  -7.00},
    {name: "04", V_pu: 1.0100, theta_deg: -17.19},
    {name: "05", V_pu: 1.0065, theta_deg:  13.61},
    {name: "06", V_pu: 0.9781, theta_deg:   3.52},
    {name: "07", V_pu: 0.9610, theta_deg:  -4.89},
    {name: "08", V_pu: 0.9486, theta_deg: -18.76},
    {name: "09", V_pu: 0.9714, theta_deg: -32.35},
    {name: "10", V_pu: 0.9835, theta_deg: -23.94},
    {name: "11", V_pu: 1.0083, theta_deg: -13.63}
  ],

  // PESTR18 Table 5.25 / App. C Table 6 — Generator scheduled output.
  // G3 is the swing bus (P closes the power balance ≈ 719.1 MW).
  syns: [
    {bus: "01", name: "G01", P_MW: 700.0, Q_Mvar: 185.0},
    {bus: "02", name: "G02", P_MW: 700.0, Q_Mvar: 234.6},
    {bus: "03", name: "G03", P_MW: 719.1, Q_Mvar: 176.0},
    {bus: "04", name: "G04", P_MW: 700.0, Q_Mvar: 202.0}
  ],

  sources: [],

  // PESTR18 Table 5.30 / App. C Table 11 — Case 5 eigenvalues (ESST1A, PSS off)
  // for reference.  PESTR18 does NOT tabulate Case 6 (PSS on) eigenvalues —
  // it documents Case 6 only via the time-domain plots in App. C §4.6.
  //
  //   freq_Hz = |imag| / (2π)    zeta = -real / sqrt(real² + imag²)
  //
  // Case 5 (PSS off, K_stab=0 on every gen — set K_stab=0 to reproduce):
  // Tool ↓ │ Local Mode Area 1 (G1↔G2) │ Local Mode Area 2 (G3↔G4) │ Inter-area (G1+G2 ↔ G3+G4)
  // ───────┼───────────────────────────┼───────────────────────────┼─────────────────────────────
  // [16]   │  −0.490 ± j7.150          │  −0.496 ± j7.350          │  +0.031 ± j3.840 (unstable)
  // LSYSAN │  −0.660 ± j7.290          │  −0.656 ± j7.090          │  +0.006 ± j3.840
  // PSSPLT │  −0.575 ± j7.060          │   (not provided)          │  +0.038 ± j3.820
  // PacDyn │  −0.639 ± j7.080          │  −0.639 ± j7.280          │  +0.022 ± j3.820
  // pydae  │  −0.528 ± j7.262          │  −0.544 ± j7.422          │  +0.190 ± j3.639 (unstable)
  //
  // Case 6 (PSS on, K_stab=20 — default configuration of this file):
  // Tool ↓ │ Local Mode Area 1 (G1↔G2) │ Local Mode Area 2 (G3↔G4) │ Inter-area (G1+G2 ↔ G3+G4)
  // ───────┼───────────────────────────┼───────────────────────────┼─────────────────────────────
  // pydae  │  −1.858 ± j9.541          │  −1.850 ± j9.736          │  −0.612 ± j4.375 (STABLE)
  // ζ      │   0.191                   │   0.187                   │   0.139
  // No PESTR18 eigenvalue reference for Case 6 — compare against App. C
  // Figures 18-19 (time-domain step response).
  //
  // Notes on Case 5 pydae vs Kundur [16]:
  //   • Local-mode damping σ ≈ −0.53/−0.54 falls right between Kundur [16]
  //     (−0.49/−0.50) and PSS/E LSYSAN (−0.66/−0.66) — well inside the
  //     PESTR18 inter-tool spread.  Frequencies match within ~1%.
  //   • Inter-area σ = +0.19 is more unstable than PSS/E (+0.006) and
  //     Kundur (+0.031) but the sign and order of magnitude are right.
  //
  // The single-element list below is so `validator.py` finds the file; it
  // uses PSS/E LSYSAN Case 5 values (App. C Table 11) for the ssa.plot_eig
  // overlay reference — they won't match the default Case 6 output.
  eigenvalues: [
    {id: "Local — Area 1 (G1↔G2)",      real: -0.65639, imag: 7.0881, freq_Hz: 1.1281, zeta: 0.0922},
    {id: "Local — Area 2 (G3↔G4)",      real: -0.66058, imag: 7.2907, freq_Hz: 1.1604, zeta: 0.0902},
    {id: "Inter-area (G1+G2 ↔ G3+G4)",  real:  0.00064617, imag: 3.8361, freq_Hz: 0.61054, zeta: -0.000168}
  ]
}

}
