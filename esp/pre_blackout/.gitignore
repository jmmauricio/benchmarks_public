# Ignore everything …
*
# … but still descend into subdirectories, so the allowlist reaches tools/.
!*/
# … except the source files for this case.
!.gitignore
!*.hjson
!*.json
!*.geojson
!*.py
!*.md

# Results: plots, spectra and interactive pages are regenerated by main.py,
# pss_design.py and plot_sld_interactive.py.
*.png
*.svg
*.html
*.csv

# Scratch and editor/tool state.
*.bak
_tmp.hjson
__pycache__/
.vscode/
