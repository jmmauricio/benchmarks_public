// Hydro single-machine-infinite-bus benchmark (Kundur §13.6-style data).
// Single 250 MVA salient-pole hydro unit, step-up line to 230 kV infinite bus.
// Stack: gensal (salient-pole 5th-order) + HYGOV turbine governor + SEXS AVR
// + LC load controller dispatching p_g = 0.8 pu.
//
// Useful for exercising the non-minimum-phase water-column response that
// is characteristic of hydro turbines: a sudden gate opening reduces
// turbine output briefly before the water column accelerates.
{
system: {name: "hydro_smib", S_base: 250e6},

buses: [
  {name: "1", P_W: 0.0, Q_var: 0.0, U_kV:  13.8},
  {name: "2", P_W: 0.0, Q_var: 0.0, U_kV: 230.0}
],

lines: [
  {bus_j: "1", bus_k: "2", X_pu: 0.10, R_pu: 0.0, Bs_pu: 0.0, S_mva: 500}
],

shunts: [
  {bus: "1", X_pu: 1e6, R_pu: 0.0, S_mva: 100}
],

syns: [
  {
    bus: "1", S_n: 250e6, type: "gensal",
    F_n: 50.0,

    // Salient-pole reactances (X_q < X_d)
    X_d: 1.05, X_q: 0.65,
    X1d: 0.30, T1d0: 6.0,
    X2d: 0.22, T2d0: 0.038,
    X2q: 0.22, T2q0: 0.099,

    R_a: 0.003,
    H: 4.0, D: 0.0,

    // d-axis saturation (PSS/E GENSAL convention)
    S_10: 0.10, S_12: 0.40,

    K_sec: 0.0, K_delta: 0.001,

    avr: {type: "sexs",
          K_a: 100.0, T_a: 0.02,
          T_b: 1.0,   T_c: 0.1,
          T_e: 0.1,
          E_min: -3.0, E_max: 4.0,
          v_ref: 1.0},

    gov: {type: "hygov",
          R: 0.05, R_r: 0.5, T_r: 5.0,
          T_f: 0.05, T_g: 0.5,
          V_g_max: 0.2,
          G_max: 1.0, G_min: 0.0,
          T_w: 1.0,
          A_t: 1.2,
          D_turb: 0.5,
          Q_nl: 0.08,
          K_awu: 1.0,
          p_c: 0.8},

    lc: {K_i: 0.01, p_c_lc: 0.8}
  }
],

sources: [{type: "vsource", bus: "2"}]
}
