{
// 68-bus (NETS/NYPS), 16-generator, 5-area benchmark — VERBATIM from PES-TR18.
// Source: IEEE PES Task Force on Benchmark Systems for Stability Controls,
// "Benchmark Systems for Small-Signal Stability Analysis and Control",
// PES-TR18 (August 2015) §5.6.  Original work: A. K. Singh, B. Pal, "Report on
// the 68-bus, 16-machine, 5-area System" (USP, 2013) and Kuiava, Fernandes,
// Mansour, Ramos, "Report on the 68-bus system using PacDyn/ANATEM" (2014).
//
// Topology: a reduced-order equivalent of the New England Test System (NETS)
// plus New York Power System (NYPS), with three other neighbouring areas
// represented as equivalent generators (G14, G15, G16) connected via three
// double-circuit tie lines (60-61, 53-54, 27-53).  Bus 16 is the slack.
//
// Approximations vs PESTR18 (no exact match in pydae yet):
//   • G1-G8, G10-G12 use the IEEE ST1A AVR (`st1`) — PESTR18 specifies the
//     IEEE DC4B excitation system (Table 5.53) which is not in pydae today;
//     ST1A with Table 5.54 parameters is the closest available approximation.
//   • PSS uses `pss_kundur_2` (Kundur 2-stage washout + lead-lag), which is
//     a structural subset of IEEE PSS1A — the 2nd-order numerator/denominator
//     blocks (A1-A6 in Table 5.55) are NOT representable; A1=0.04, A5=0.15 on
//     the †† generators are dropped.  For small-signal analysis at the
//     electromechanical frequencies the impact is small.
//   • G13-G16 are equivalent generators representing other areas; PESTR18
//     does not specify AVRs/PSSs for them.  Modelled here with constant
//     field voltage (no AVR) and no PSS.
//
// System base: S_base = 100 MVA, 60 Hz.  GSUs on 100 MVA base per Table 5.47.

system: {name: "system68bus", S_base: 100e6},
agc: {K_p_agc: 0.0, K_i_agc: 0.01, gen: "G16"}

// PESTR18 Tables 5.43 + 5.44 — 68 buses.  V_base is not tabulated per bus by
// PES-TR18, so a representative 230 kV is used for the transmission network
// and 20 kV for the generator low-voltage buses — these are dynamics-irrelevant
// (pydae uses per-unit internally) and only matter if you convert outputs to SI.
buses: [
  {name: "01", P_W: 0, Q_var: 0, U_kV:  20.0},
  {name: "02", P_W: 0, Q_var: 0, U_kV:  20.0},
