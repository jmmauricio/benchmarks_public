shunts: [{bus:"60", X_pu:1e6, R_pu:0.0, S_mva:100}],

// PESTR18 Tables 5.50-5.52 — synchronous machine data on each machine MBASE.
// PSS/E GENROE → pydae genroe (6th-order, geometric saturation S(E)=B·E^N).
// X_l listed by PESTR18 is intentionally NOT passed to genroe — PSS/E /
// IEEE 1110 convention treats X''d, X''q as terminal-referred.
//
// Per PESTR18 §4.6, G1-G12 use IEEE DC4B AVRs (Table 5.53) and G9 uses ST1A
// (Table 5.54).  pydae has ST1A (`st1`) but not DC4B today — every gen with an
// AVR uses `st1` with Table 5.54 parameters as the closest approximation.
// G13-G16 are equivalent generators for areas 3, 4, 5 — no AVR, no PSS, with
// constant field voltage.  Each is anchored via K_delta=0 so they can drift.
// G16 (slack) carries K_delta=0.001 + Delta_ref=0.
//
// PSS — IEEE PSS1A (Table 5.55) on G1-G12; pydae's `pss_kundur_2` implements
// the washout + two-stage lead-lag; the 2nd-order numerator/denominator
// blocks (A1-A6) of PSS1A are not representable and are dropped.
// Set K_stab=0 on every gen to disable PSS (Case 1 in PESTR18 §5.6.3).
syns: [
  // G1 — Area 1 (PV, V=1.045)
