    description: "p_g_1 (MW) response to v_ref_4 step to 1.027 pu (NTS doc says 1.02)",
    v_ref_4_step: 1.027,
    v_ref_4_ini:  1.0,
    t_step: 2.0,
    dt: 0.2,
