{
system: {name: "nts", S_base: 1e9},

// AGC on gen at bus 4 (K_sec=1, angle reference K_delta=0.0001)
agc: {gen: "4", K_p_agc: 0.0, K_i_agc: 0.001},

buses: [
  {name: "1", P_W: 0.0, Q_var: 0.0, U_kV:  19.0},
  {name: "2", P_W: 0.0, Q_var: 0.0, U_kV: 230.0},
  {name: "3", P_W: 0.0, Q_var: 0.0, U_kV: 230.0},
  {name: "4", P_W: 0.0, Q_var: 0.0, U_kV:  19.0},
  {name: "5", P_W: 0.0, Q_var: 0.0, U_kV:  19.0}
],

lines: [
  {bus_j: "1", bus_k: "2", X_pu: 0.15, R_pu: 0.0,  S_mva: 1500},
  {bus_j: "2", bus_k: "3", X_pu: 0.01, R_pu: 0.0,  Bs_pu: 0.0, S_mva: 100},
  {bus_j: "3", bus_k: "4", X_pu: 0.15, R_pu: 0.0,  S_mva: 5000},
  {bus_j: "5", bus_k: "2", X_pu: 0.01, R_pu: 0.0,  S_mva: 1000}
],

loads: [
  {bus: "2", type: "zip", p_mw: 1250, q_mvar: 0, K_zp: 0, K_zq: 1.0, K_ip: 1.0, K_iq: 0.0},
  {bus: "3", type: "zip", p_mw: 4000, q_mvar: 0, K_zp: 0, K_zq: 1.0, K_ip: 1.0, K_iq: 0.0}
],

syns: [

  // ── Generator at bus 1 (1500 MVA, IEEE 1110 Model 2.2 / GENROU) ──────
  // Parameters taken literally from NTS Tabla 45 (Iberdrola unit).
  // No X_l field: genrou's X2d/X2q are terminal-referred (IEEE 115 Eq. 88).
  {bus: "1", S_n: 1500e6, type: "genrou",
   X_d: 2.135, X1d: 0.34,  T1d0: 6.47,
   X_q: 2.046, X1q: 0.573, T1q0: 0.61,
   X2d: 0.269, T2d0: 0.022,
   X2q: 0.269, T2q0: 0.034,
   R_a: 0.0,
   S_10: 0.1275, S_12: 0.2706,
   H: 6.3, D: 0.0,
   F_n: 50.0, omega_s: 1.0, K_sec: 0.0, K_delta: 0.0,

   avr: {type: "st4b", bus: "2",
         T_R: 0.02,
         K_PR: 3.15,   K_IR: 3.15,
         V_RMAX: 1.0,  V_RMIN: -0.87,
         T_A: 0.02,
         K_PM: 1.0,    K_IM: 0.0,    // K_IN = 0 per table
         V_MMAX: 1.0,  V_MMIN: -0.87,
         K_G: 0.0,     K_P: 6.5,
         V_BMAX: 8.0,
         // K_C: -0.08, X_L: 0.0, theta_P: 0  ← full IEEE ST4B params, not yet used
         v_ref: 1.0},

   pss: {type: "pss2a",
         T_w1: 2.0, T_w2: 2.0,   // speed washouts
         T_6: 0.0,                 // speed transducer lag (unity pass-through)
         T_w3: 2.0, T_w4: 0.0,   // power washouts
         T_7: 2.0,  K_s2: 0.158, // power-channel lag and scale
         K_s3: 1.0,               // ramp-tracker mix gain
         T_8: 0.0,  T_9: 0.1,    // ramp-tracking filter (T8=0 → pure lag)
         M: 5,      N: 1,         // ramp-tracker order (6 total lags)
         K_s1: 17.069,
         T_1: 0.28, T_2: 0.04,
         T_3: 0.28, T_4: 0.12,
         V_STmax: 0.1, V_STmin: -0.1},

   lc: {K_i: 0.0001, p_c_lc: 0.9}},

  // ── Generator at bus 4 (5000 MVA, IEEE 1110 Model 2.2 / GENROU) ─────
  // ieeeg1 governor + st1 AVR + AGC participation.
  {bus: "4", S_n: 5000e6, type: "genrou",
   X_d: 1.8,  X1d: 0.3,  T1d0: 8.0,
   X_q: 1.7,  X1q: 0.55, T1q0: 0.4,
   X2d: 0.25, T2d0: 0.03,
   X2q: 0.25, T2q0: 0.05,
   R_a: 0.0,
   S_10: 0.0392, S_12: 0.2227,
   H: 6.175, D: 0.0,
   Omega_b: 314.1592653589793, omega_s: 1.0, K_sec: 1.0, K_delta: 0.0001,

   avr: {type: "st1", bus: "3",
         T_R: 0.01,
         T_B: 10.0, T_C: 1.0,
         K_A: 200.0, T_A: 0.0,
         V_Imax:  999.0, V_Imin: -999.0,
         V_Rmax:  999.0, V_Rmin: -999.0,
         // K_C=0, K_F=0, T_F=1 — REE simplification (K_F=0 removes feedback)
         v_ref: 1.0},

   gov: {type: "ieeeg1",
         K: 20, K_1: 0.3, K_3: 0.3, K_5: 0.4, K_7: 0,
         K_2: 0,  K_4: 0,  K_6: 0,  K_8: 0,
         T_1: 0, T_2: 0.0, T_3: 0.1, T_4: 0.3, T_5: 7, T_6: 0.6,
         T_7: 0,
         U_o: 0.5, U_c: -0.5,
         P_min: 0.0, P_max: 1.0}}
   // No lc — AGC connects directly to ieeeg1 p_c and finds the balance freely.

],

// ── VALIDATION RESULTS (pydae previous version) ───────────────────────
// Power balance: P_g1 + P_g4 + P_s5 = 1350 + 3900 + 1350 = 6600 MW
// Loads: bus2=1250 MW, bus3=4000 MW (ZIP, K_ip=1 so actual = rated * V)
// Total reactive: Q_g1 + Q_g4 = 215.69 + 489.67 = 705.36 Mvar
results: {
  buses: [
    {name: "1", V_pu: 1.0124, theta_deg: null},  // theta not recorded
    {name: "2", V_pu: 1.0000, theta_deg: null},
    {name: "3", V_pu: 1.0000, theta_deg: null},
    {name: "4", V_pu: 1.0078, theta_deg: null}
    // bus 5 voltage not recorded
  ],
  syns: [
    {bus: "1", P_MW: 1350.0, Q_Mvar: 215.69, v_f: 2.31},
    {bus: "4", P_MW: 3900.0, Q_Mvar: 489.67, v_f: 1.70}
  ],
  // External equivalent source at bus 5 (present in previous model)
  sources: [
    {bus: "5", P_MW: 1350.0, Q_Mvar: 182.0}
  ],

  // ── Step-response test: v_ref_4 step ──────────────────────────────
  // Test: step v_ref_4 → 1.027 at t=0, observe p_g_1 (MW) over 50 s.
  //
  // NOTE ON V_REF DISCREPANCY:
  //   The NTS REE document specifies the step target as v_ref_4 = 1.02 pu.
  //   However, to match the NTS reference waveform in pydae the step must
  //   be applied to v_ref_4 = 1.027 pu.  The reason is not yet understood
  //   and is recorded here for future investigation.
  //
  // Ini condition: p_g_1 = 1350 MW (p_c_lc_1 = 0.9 on 1500 MVA base).
  // The AVR on gen 1 (ST4B, remote bus "2") responds to the voltage change
  // on bus 3 via gen 4's AVR, producing the active-power swing shown below.
